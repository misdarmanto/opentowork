{
  "name": "open-work",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source platform for building and running teams of AI agents through structured, durable workflows.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
