    "test": "pnpm -r --if-present run test",
    "lint": "eslint . --max-warnings=0",
    "dev:cli": "pnpm --filter @open-work/cli dev"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "globals": "^15.11.0",
    "typescript-eslint": "^8.15.0",
    "prettier": "^3.3.0"
  }
}
